{
  "name": "transit-colors",
  "version": "0.1.0",
  "private": true,
  "description": "Explore transit access, maximum-area routes, civil-time skew, and parcel land use on an interactive map.",
  "homepage": "https://liambutler-lawrence.github.io/transit-colors/",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/liambutler-lawrence/transit-colors.git"
  },
  "bugs": {
    "url": "https://github.com/liambutler-lawrence/transit-colors/issues"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "packageManager": "npm@10.9.4",
  "scripts": {
    "build:vendor": "node scripts/copy-vendor-assets.mjs",
    "build:data:cdmx": "node scripts/build-cdmx-data.mjs && tsx scripts/build-street-access.mjs && tsx scripts/build-cdmx-tiles.mjs",
    "build:data:cdmx:derived": "node scripts/rebuild-cdmx-derived-data.mjs && tsx scripts/build-street-access.mjs && tsx scripts/build-cdmx-tiles.mjs",
    "build:tiles:cdmx": "tsx scripts/build-cdmx-tiles.mjs",
    "build:data:nyc": "node scripts/build-nyc-data.mjs",
    "build:data:additional": "node scripts/build-additional-metro-data.mjs",
    "build:data:singapore": "node scripts/build-additional-metro-data.mjs singapore",
    "build:data:atlanta": "node scripts/build-additional-metro-data.mjs atlanta",
    "build:data:athens": "node scripts/build-additional-metro-data.mjs athens",
    "build:data:access": "tsx scripts/build-street-access.mjs",
    "build:data:landmasses": "tsx scripts/build-circumference-landmasses.mjs",
    "build:data:schedules": "tsx scripts/build-gtfs-schedules.mjs",
    "build:data:tracks": "node scripts/build-track-geometries.mjs",
    "build:data:timezone-skew": "node scripts/build-timezone-skew-data.mjs",
    "build:data:land-use": "node --import tsx scripts/build-jersey-city-land-use.mjs",
    "build:tiles:timezone-skew": "node scripts/build-timezone-skew-tiles.mjs",
    "build:data:timezone-countries": "node scripts/build-timezone-country-data.mjs",
    "build:data:circumference": "node --import tsx scripts/build-circumference-data.mjs",
    "build:data:highways": "node --expose-gc --max-old-space-size=12288 --import tsx scripts/build-osm-highway-circumference-data.mjs",
    "build:data": "npm run build:data:cdmx && npm run build:data:schedules && npm run build:data:nyc && npm run build:data:additional && npm run build:data:tracks && npm run build:data:timezone-skew && npm run build:data:timezone-countries && npm run build:tiles:timezone-skew && npm run build:data:circumference && npm run build:data:land-use",
    "build": "vite build",
    "dev": "vite",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "test": "node --import tsx --test src/*.test.mjs scripts/*.test.mjs",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm test && npm run build"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@mapbox/vector-tile": "^3.0.0",
    "@types/geojson": "^7946.0.16",
    "@types/node": "^26.2.0",
    "earcut": "^3.2.3",
    "eslint": "^10.8.1",
    "globals": "^17.11.0",
    "highs": "^1.15.2",
    "maplibre-gl": "6.4.1",
    "pbf": "^5.1.2",
    "pmtiles": "4.5.0",
    "polygon-clipping": "0.15.7",
    "prettier": "^3.9.6",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2",
    "typescript-eslint": "^8.67.0",
    "vite": "^8.2.1"
  },
  "dependencies": {
    "geographiclib-geodesic": "^2.2.0",
    "zod": "^4.4.3"
  }
}
